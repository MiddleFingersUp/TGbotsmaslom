# TGbots — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials to Git.

# ─── Application ────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=INFO

# ─── PostgreSQL ─────────────────────────────────────────
POSTGRES_USER=tgbots
POSTGRES_PASSWORD=
POSTGRES_DB=tgbots
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://tgbots:changeme@postgres:5432/tgbots

# ─── LLM Provider ──────────────────────────────────────
# LLM_PROVIDER: 'openai' (OpenAI-compatible) | 'mock' (offline test provider).
# Unset → 'mock' (safe offline default for development).
# No concrete cloud vendor is selected yet (SEC-OD-1): any OpenAI-compatible
# service is configured through LLM_API_BASE_URL + LLM_API_KEY.
LLM_PROVIDER=
# Local llama-server example (development only, never production settings):
# LLM_PROVIDER=openai
# LLM_API_BASE_URL=http://127.0.0.1:1234/v1
# LLM_API_KEY=local-dev-key
# LLM_DEFAULT_MODEL=qwen3.5-9b
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_DEFAULT_MODEL=
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.5
LLM_MAX_TOKENS=

# ─── Security ──────────────────────────────────────────
WEBHOOK_SECRET=
ADMIN_API_TOKEN=
