# TGbots — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env with real credentials to Git.

# ─── Application ────────────────────────────────────────
APP_ENV=dev
LOG_LEVEL=INFO

# ─── PostgreSQL ─────────────────────────────────────────
POSTGRES_USER=tgbots
POSTGRES_PASSWORD=
POSTGRES_DB=tgbots
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://tgbots:changeme@postgres:5432/tgbots

# ─── LLM Provider ──────────────────────────────────────
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_DEFAULT_MODEL=

# ─── Security ──────────────────────────────────────────
WEBHOOK_SECRET=
ADMIN_API_TOKEN=
